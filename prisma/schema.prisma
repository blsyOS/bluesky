// BlueSky OS — Multi-Tenant Platform Foundation
//
// Company is the top-level tenant object. Products belong to the platform
// and are licensed to companies through CompanyProduct. Users belong to one
// company; their access to products is controlled through UserProductRole.
//
// SQLite does not support native enums, so status/key fields are strings
// constrained by the typed constants in src/lib/constants.ts.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Company {
  id           String    @id @default(cuid())
  name         String
  legalName    String?
  dba          String? // "doing business as"
  slug         String    @unique
  subdomain    String    @unique
  status       String    @default("active") // trial | active | suspended | archived
  description  String?
  foundedDate  DateTime?
  website      String?

  // Branding (favicon/email fields are future-ready placeholders)
  logoUrl        String?
  primaryColor   String?
  secondaryColor String?
  accentColor    String?
  faviconUrl     String?
  emailLogoUrl   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users            User[]
  products         CompanyProduct[]
  roles            Role[]
  auditLogs        AuditLog[]
  settings         CompanySettings?
  contacts         Contact[]
  contactInfo      CompanyContactInfo?
  addresses        CompanyAddress[]
  serviceTerritory CompanyServiceTerritory?
  featureFlags     CompanyFeatureFlag[]
  locations        OrganizationLocation[]
  departments      Department[]
  teams            Team[]

  @@map("companies")
}

// ── Organization structure (BO-02.01C) ─────────────────────────────────
// The shared organizational skeleton every product operates against:
// Locations → Departments → Teams. Employees, vehicles, equipment,
// inventory, and dispatch areas will reference these models in future
// build orders — no such relationships exist yet by design.

// A physical operating location (headquarters, service center, utility
// yard, temporary storm office, …). Types/statuses are typed string
// constants in src/lib/organization.ts.
model OrganizationLocation {
  id          String  @id @default(cuid())
  companyId   String
  name        String
  code        String? // short operational code, e.g. "HQ", "YARD-01"
  type        String  @default("branch_office")
  status      String  @default("active") // active | inactive
  description String?

  // Address
  addressLine1 String?
  addressLine2 String?
  city         String?
  state        String?
  postalCode   String?
  country      String? @default("USA")

  // Operations
  timezone           String?
  businessHoursStart String? // "08:00"
  businessHoursEnd   String? // "17:00"
  phone              String?
  email              String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, name])
  @@index([companyId, status])
  @@map("organization_locations")
}

// An organizational function (Operations, Dispatch, Safety, …). The
// platform offers a default set (src/lib/organization.ts) and
// organizations add their own. Manager and default location are future
// employee-foundation fields and intentionally not modeled yet.
model Department {
  id          String  @id @default(cuid())
  companyId   String
  name        String
  description String?
  active      Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  teams   Team[]

  @@unique([companyId, name])
  @@index([companyId, active])
  @@map("departments")
}

// A working unit inside a department (Locate Team A, Dispatch Day
// Shift, …). Team lead, members, equipment, vehicles, and schedules are
// future build orders.
model Team {
  id           String  @id @default(cuid())
  companyId    String
  departmentId String
  name         String
  code         String? // short operational code, e.g. "LOC-A"
  description  String?
  active       Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company    Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@unique([companyId, name])
  @@index([companyId, departmentId])
  @@map("teams")
}

// Company-level contact channels (1:1). Future-ready fields may exist here
// unused; employee/user contact data lives elsewhere.
model CompanyContactInfo {
  id             String  @id @default(cuid())
  companyId      String  @unique
  mainPhone      String?
  mainEmail      String?
  emergencyPhone String?
  afterHoursPhone String?
  billingEmail   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("company_contact_info")
}

// One row per address type. Types are open strings driven by constants in
// src/lib/company.ts (headquarters | mailing | billing today) so future
// types are added without schema or UI-logic changes.
model CompanyAddress {
  id           String  @id @default(cuid())
  companyId    String
  type         String
  companyLine  String? // company name as printed on the address
  addressLine1 String?
  addressLine2 String?
  city         String?
  state        String?
  postalCode   String?
  country      String? @default("USA")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, type])
  @@map("company_addresses")
}

// Where the company operates (1:1). States/counties are JSON string arrays
// for SQLite portability.
model CompanyServiceTerritory {
  id          String  @id @default(cuid())
  companyId   String  @unique
  states      String? // JSON string array
  counties    String? // JSON string array
  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("company_service_territories")
}

// Per-company feature flags. Keys are open strings; the known set lives in
// src/lib/company.ts so modules can add flags without schema changes.
model CompanyFeatureFlag {
  id        String  @id @default(cuid())
  companyId String
  key       String
  enabled   Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, key])
  @@map("company_feature_flags")
}

// Operational contact directory used by BlueSky Locate (not a general CRM).
// Contact type/subtype are typed string constants (see src/lib/contacts.ts).
// Address and list fields are stored flattened / as JSON strings for SQLite;
// document/agreement attachments are future-ready and not modeled yet.
model Contact {
  id            String   @id @default(cuid())
  companyId     String
  contactType   String // group id, e.g. utility_owner, municipality
  subtype       String? // specific, e.g. gas, city, excavator
  status        String   @default("active") // active | inactive

  // General
  organization  String? // company / organization name
  contactName   String
  title         String?
  department    String?

  // Communication
  officePhone   String?
  mobilePhone   String?
  email         String?
  fax           String?

  // Addresses
  billingAddress  String?
  mailingAddress  String?
  physicalAddress String?

  // Operational
  utilityServed String?
  serviceArea   String?
  counties      String? // JSON string array
  states        String? // JSON string array
  notes         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, contactType])
  @@map("contacts")
}

model Product {
  id          String   @id @default(cuid())
  key         String   @unique // LOCATE_OS | LEAK_OS | FIBER_OS | SITE_VIEW | COMMAND_CENTER
  name        String
  description String?
  status      String   @default("active") // active | coming_soon | hidden
  accentColor String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  companies        CompanyProduct[]
  roles            Role[]
  permissions      Permission[]
  userProductRoles UserProductRole[]

  @@map("products")
}

model CompanyProduct {
  id         String    @id @default(cuid())
  companyId  String
  productId  String
  status     String    @default("active") // active | trial | disabled
  enabledAt  DateTime?
  disabledAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([companyId, productId])
  @@map("company_products")
}

model User {
  id        String   @id @default(cuid())
  companyId String
  firstName String
  lastName  String
  email     String   @unique
  phone     String?
  avatarUrl String?
  status    String   @default("invited") // active | inactive | invited | suspended
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company      Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  productRoles UserProductRole[]
  auditLogs    AuditLog[]

  @@index([companyId])
  @@map("users")
}

model Role {
  id           String   @id @default(cuid())
  companyId    String? // null = system role available to all companies
  productId    String? // null = platform-wide role
  name         String
  key          String
  description  String?
  isSystemRole Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  company          Company?          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  product          Product?          @relation(fields: [productId], references: [id], onDelete: Cascade)
  permissions      RolePermission[]
  userProductRoles UserProductRole[]

  @@unique([companyId, productId, key])
  @@map("roles")
}

model Permission {
  id          String   @id @default(cuid())
  key         String   @unique
  name        String
  description String?
  productId   String? // null = platform-wide permission
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  product Product?         @relation(fields: [productId], references: [id], onDelete: Cascade)
  roles   RolePermission[]

  @@map("permissions")
}

model RolePermission {
  id           String @id @default(cuid())
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

model UserProductRole {
  id        String @id @default(cuid())
  userId    String
  productId String
  roleId    String

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  role    Role    @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, productId, roleId])
  @@index([userId])
  @@map("user_product_roles")
}

model AuditLog {
  id          String   @id @default(cuid())
  companyId   String
  userId      String?
  action      String // e.g. user.created, company_product.enabled
  entityType  String
  entityId    String?
  description String
  metadata    String? // JSON payload
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([companyId, createdAt])
  @@map("audit_logs")
}

model CompanySettings {
  id           String   @id @default(cuid())
  companyId    String   @unique
  timezone     String   @default("America/Chicago")
  dateFormat   String   @default("MM/DD/YYYY")
  timeFormat   String   @default("12h")
  defaultTheme String   @default("system") // light | dark | system

  // Business & operations defaults (BO-02.01C). Holidays, scheduling
  // rules, and dispatch defaults arrive with their modules.
  workWeek           String @default("monday_friday") // see WORK_WEEKS
  businessHoursStart String @default("08:00")
  businessHoursEnd   String @default("17:00")
  defaultShiftHours  Int    @default(8)

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("company_settings")
}
